# ==== Server ====
PORT=3000

# Vaqtincha: true bo'lsa hamma foydalanuvchi to'lovsiz VIP/faol hisoblanadi
# (to'lov tizimi ishlashda davom etadi, faqat gating o'chiriladi).
FREE_MODE=false

# Webhook tekshiruvi uchun o'zingiz o'ylab topgan maxfiy so'z
# (Meta Developer panelda webhook sozlashda shuni kiritasiz)
VERIFY_TOKEN=mening-maxfiy-tokenim

# Meta App maxfiy kaliti (webhook imzosi + Facebook OAuth uchun)
# Meta App → Settings → Basic → App Secret
APP_SECRET=

# ==== "Facebook bilan ulash" (OAuth, self-service) ====
# Bular berilsa, tadbirkorlar Instagram'ini bir tugma bilan o'zi ulaydi.
# Berilmasa — tokenlarni admin qo'lda kiritadi (baribir ishlaydi).
FB_APP_ID=
# Serverning tashqi manzili (OAuth redirect uchun), oxirida / bo'lmasin.
# Meta App → Facebook Login → Valid OAuth Redirect URIs ga
# "<BASE_URL>/connect/facebook/callback" ni qo'shing.
BASE_URL=https://sizning-domen.uz

# Graph API versiyasi
GRAPH_API_VERSION=v21.0

# Admin (dasturchi) email'lari — bu hisoblar barcha bizneslarning
# Meta tokenlarini boshqara oladi (/admin panel). Vergul bilan bir nechta.
# Avval shu email bilan ro'yxatdan o'ting, keyin admin bo'lasiz.
ADMIN_EMAILS=admin@example.com

# ==== AI — platforma kaliti (dasturchi kiritadi) ====
# Bu kalit butun platforma uchun ishlaydi — tadbirkorlar o'z kalitini
# kiritmaydi. (Kerak bo'lsa, admin bitta biznesga alohida kalit bera oladi.)

# Gemini: https://aistudio.google.com/apikey (bepul tarif bor)
# Ovoz/rasm/video tahlili uchun Gemini kerak.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (ixtiyoriy muqobil): https://platform.claude.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ==== Ovozli javob (TTS) — ixtiyoriy ====
# Google Cloud Text-to-Speech kaliti. Berilsa, bizneslar WhatsApp'da
# ovozli javobni yoqishi mumkin (matn bilan birga ovoz ham yuboriladi).
GOOGLE_TTS_API_KEY=
TTS_LANG=uz-UZ
# TTS_VOICE=uz-UZ-Standard-A

# ==== Telegram bildirishnoma — ixtiyoriy ====
# @BotFather dan olingan bot token. Berilsa, operator chaqirilganda
# biznes egasiga Telegram orqali xabar keladi.
TELEGRAM_BOT_TOKEN=

# ==== Telegram "Hisobot Boti" — ixtiyoriy ====
# Alohida, butun platforma uchun UMUMIY bot (@BotFather dan). Tadbirkor botni
# ochib tilni tanlaydi, telefon raqamini yuboradi — tizim shu raqam orqali
# /settings sahifasidagi akkauntga bog'lab, statistikasini ko'rsatadi.
REPORTS_BOT_TOKEN=

# ==== Payme to'lov tizimi — ixtiyoriy ====
# business.payme.uz da merchant yaratasiz. Endpoint URL: https://<BASE_URL>/payme
# Berilsa, tadbirkorlar obunani Payme orqali avtomatik to'laydi.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
PAYME_ACCOUNT_FIELD=order_id

# ==== PostgreSQL — ixtiyoriy (bo'lmasa data/db.json fayl bazasi ishlatiladi) ====
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASS=
PG_DB=
# Ishga tushishda PostgreSQL'ga nechta urinib ko'rish (so'ng JSON'ga o'tadi va admin panelda ogohlantiradi)
PG_CONNECT_RETRIES=5

# Saytdagi "Bog'lanish" formasidan kelgan murojaatlar shu Telegram chatga ham yuboriladi (ixtiyoriy)
ADMIN_TELEGRAM_CHAT_ID=

# ==== Deploy/debug skriptlari uchun (scripts/deploy.js, scripts/restart.js, ...) ====
# Bu qiymatlar HECH QACHON kodga hardcode qilinmasin — faqat shu yerda, .env ichida turadi.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=

# ==== Platforma email (parolni tiklash, email tasdiqlash, obuna eslatmalari) ====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Obunext <no-reply@obunext.uz>

# ==== Zaxira nusxa (har kuni avtomatik; ADMIN_TELEGRAM_CHAT_ID + TELEGRAM_BOT_TOKEN bo'lsa Telegram'ga ham) ====
BACKUP_KEEP=14
BACKUP_DISABLED=false

# ==== Payme fiskal chek (admin panel → Tariflar'da ham kiritiladi) ====
PAYME_IKPU=
PAYME_PACKAGE_CODE=
