# ==== Server ====
PORT=3015
# production'da Docker image o'zi NODE_ENV=production qo'yadi
# NODE_ENV=production
# Nginx orqasida: 1 ta ishonchli proksi qatlami (req.ip to'g'ri aniqlanishi uchun)
TRUST_PROXY=1
# Loglar: json — Loki/ELK uchun bir qatorli JSON; bo'sh — oddiy matn
LOG_FORMAT=

# Vaqtincha: true bo'lsa hamma foydalanuvchi to'lovsiz VIP/faol hisoblanadi
# (to'lov tizimi ishlashda davom etadi, faqat gating o'chiriladi).
FREE_MODE=false

# Webhook tekshiruvi uchun o'zingiz o'ylab topgan maxfiy so'z
# (Meta Developer panelda webhook sozlashda shuni kiritasiz)
VERIFY_TOKEN=mening-maxfiy-tokenim

# Meta App maxfiy kaliti (webhook imzosi + Facebook OAuth uchun). MAJBURIY:
# bo'lmasa barcha webhooklar rad etiladi. Meta App → Settings → Basic → App Secret
APP_SECRET=

# ==== "Instagram bilan ulash" (OAuth, self-service) ====
FB_APP_ID=
# Instagram API with Instagram Login: Meta App → Use cases → Instagram → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# App Review'dan o'tgan qo'shimcha ruxsatlar (vergul bilan). Post rejalashtirish va statistika uchun:
# IG_EXTRA_SCOPES=instagram_business_content_publish,instagram_business_manage_insights
IG_EXTRA_SCOPES=
# Serverning tashqi manzili (OAuth redirect uchun), oxirida / bo'lmasin.
# Meta panelga "<BASE_URL>/connect/instagram/callback" redirect sifatida qo'shiladi.
BASE_URL=https://obunext.uz

# Graph API versiyasi
GRAPH_API_VERSION=v21.0

# ==== Admin panel ====
# Admin panel faqat shu domenda ochiladi (boshqa domen/IP orqali /admin → 404)
ADMIN_HOST=adm.obunext.uz
# Birinchi kirish uchun login (telefon raqam) va parol. Kodda standart parol YO'Q —
# bular bo'lmasa admin panelga kirib bo'lmaydi. Panel → Xavfsizlik'da almashtirilgach,
# bazadagisi ustun turadi.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Biznes kabinetida "admin" belgisi beriladigan email(lar), vergul bilan
ADMIN_EMAILS=admin@example.com

# ==== Maxfiy ma'lumotlarni shifrlash ====
# Meta/Telegram tokenlari, to'lov kalitlari, SMS/SMTP parollari bazada va zaxirada
# shifrlangan holda saqlanadi (AES-256-GCM). Yaratish: openssl rand -hex 32
# DIQQAT: kalitni yo'qotmang va o'zgartirmang — usiz shifrlangan tokenlarni ochib bo'lmaydi.
# Bo'lmasa: tokenlar ochiq saqlanadi va zaxira Telegram'ga YUBORILMAYDI.
DATA_ENCRYPTION_KEY=

# ==== AI — platforma kaliti (dasturchi kiritadi) ====
# Gemini: https://aistudio.google.com/apikey — asosiy AI (ovoz/rasm/video tahlili ham)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude — zaxira AI (Gemini ishlamasa): https://platform.claude.com
ANTHROPIC_API_KEY=
# Standart: claude-opus-5 ($5/$25 per 1M token). Arzonroq variant: claude-sonnet-5 ($2/$10)
# yoki claude-haiku-4-5 ($1/$5). Narxni admin panel → "AI xarajati"da ham moslang.
AI_MODEL=claude-opus-5

# ==== Ovozli javob (TTS) — ixtiyoriy ====
GOOGLE_TTS_API_KEY=
TTS_LANG=uz-UZ
# TTS_VOICE=uz-UZ-Standard-A

# ==== "Google bilan kirish" — ixtiyoriy ====
# Google Cloud Console → Credentials → OAuth Client ID. Redirect: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== Telegram bildirishnoma — ixtiyoriy ====
TELEGRAM_BOT_TOKEN=
# Server xatolari, baza muammosi, saytdan murojaatlar va (shifrlangan) kunlik zaxira shu chatga
ADMIN_TELEGRAM_CHAT_ID=

# ==== Telegram "Hisobot Boti" — ixtiyoriy ====
REPORTS_BOT_TOKEN=

# ==== Payme to'lov tizimi — ixtiyoriy ====
# business.payme.uz da merchant. Endpoint URL: <BASE_URL>/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
PAYME_ACCOUNT_FIELD=order_id
# Fiskal chek (admin panel → Tariflar'da ham kiritiladi)
PAYME_IKPU=
PAYME_PACKAGE_CODE=

# ==== PostgreSQL ====
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASS=
PG_DB=
# Ishga tushishda nechta urinish. Ulanmasa server TO'XTAYDI (Docker qayta ishga tushiradi) —
# JSON faylga jimgina o'tib, ma'lumotlar ikkiga bo'linib ketmasligi uchun.
PG_CONNECT_RETRIES=5
# Faqat favqulodda holat uchun: true bo'lsa Postgres ulanmasa ham JSON fayl bilan ishlaydi
PG_ALLOW_JSON_FALLBACK=false
# Ma'lumotlar papkasi (media, suhbat arxivi, JSON rejimida db.json). Standart: ./data
# DATA_DIR=

# ==== Platforma email (parolni tiklash, email tasdiqlash, obuna eslatmalari) ====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Obunext <no-reply@obunext.uz>

# ==== Zaxira nusxa (har kuni avtomatik) ====
BACKUP_KEEP=14
BACKUP_DISABLED=false

# ==== Deploy (scripts/deploy.js, scripts/ssh.js) — faqat lokal kompyuterda ====
# Qiymatlar HECH QACHON kodga yozilmasin. Parol o'rniga SSH kalit tavsiya etiladi.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=
SSH_PASSWORD=
